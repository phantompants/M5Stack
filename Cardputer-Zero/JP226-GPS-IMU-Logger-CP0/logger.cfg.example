# Copy to ~/.config/jp226-gps-imu-logger/logger.cfg (or /etc/jp226-gps-imu-logger/logger.cfg,
# or point $JP226_CP0_CONFIG at it). Every value is optional.
#
# Wi-Fi is NOT configured here: the CardputerZero runs Linux, join networks with
# the operating system. Never put a Wi-Fi password in this repository.

# When true (default) the time zone follows the GPS position (offline table of
# Australian zones; same answer 3 checks 30 s apart before it changes).
timezone_auto=true

# Optional POSIX rule or Australian IANA name used until the GPS position says
# otherwise (default: the saved zone, else Australia/Sydney).
# timezone=AEST-10AEDT,M10.1.0,M4.1.0/3

# GPS serial port. Leave both commented to auto-detect (tries /dev/serial0,
# /dev/ttyAMA0, /dev/ttyS0, /dev/ttyUSB0 at 115200, 9600, 38400,
# 4800, 19200, 57600 baud). HARDWARE UNVERIFIED: confirm next week.
# gps_device=/dev/ttyAMA0
# gps_baud=115200

# Which GPS receiver to use. cap = LoRa-1262 GPS Cap on /dev/ttyS0 (EXT 5V on);
# grove = a Grove GPS on the Zero's own Grove port (Grove 5V on, port switched
# to UART); atom = the AtomS3 USB bridge's GPS Base on /dev/ttyACM0. Use atom
# with the NFC/Sub-1GHz Cap fitted: that Cap blocks the UART, so neither cap
# nor grove works with it. Key 4 on the GPS page changes it on the device.
# gps_source=cap

# SHARE page web server port. Ports below 1024 need root; 8080 is taken by
# RaspyJack on the CardputerZero.
# web_port=8226

# Where CSV files are written (default ~/telemetry).
# data_dir=/home/pi/telemetry

# auto = system clock until GPS time is seen, then GPS; gps = GPS only; system = never use GPS time.
# clock_source=auto
